# QEVION — copy to .env (git-ignored). NEVER commit real values.
# CredentialResolver order: env -> admin store -> ephemeral UI key (QV-CRED, ADR-0002)

QEVION_ENV=dev
QEVION_HOST=0.0.0.0
QEVION_PORT=8000
QEVION_LOG_LEVEL=INFO

# Provider credentials (leave empty to use Admin UI ephemeral key or mocks)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
GEMINI_API_KEY=
TYPESAFE_API_KEY=                 # decision role (rules+typesafe composition); or Admin ephemeral test-key

# Composition default: s2s | cascade
QEVION_COMPOSITION=s2s
QEVION_PROVIDER_S2S=mock          # mock | openai_realtime | gemini_live
QEVION_PROVIDER_TURN=silero       # silero | provider_delegated | mock

# Budget guards (QV-COST, D14)
QEVION_BUDGET_USD_PER_DAY=10
QEVION_MAX_SESSION_SECONDS=300
QEVION_MAX_SESSIONS_PER_DAY=20

# Privacy (QV-PRIV)
QEVION_RETAIN_AUDIO=false
QEVION_REDACT_TRANSCRIPTS=true

# Evidence / replay
QEVION_EVIDENCE_DIR=evidence
QEVION_RECORD_SESSIONS=true
