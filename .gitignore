# secrets — never tracked
.env
.env.*
!.env.example
*.pem
*.key
.git-credentials
# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
!web/dist/
!web/dist/**
build/
