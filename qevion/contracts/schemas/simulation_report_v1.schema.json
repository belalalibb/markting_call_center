{
  "$defs": {
    "ActivationThresholds": {
      "additionalProperties": false,
      "description": "Fixed before running (QV-SIM-005).",
      "properties": {
        "completion_pass_rate": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Completion Pass Rate",
          "type": "number"
        },
        "require_adversarial": {
          "default": true,
          "title": "Require Adversarial",
          "type": "boolean"
        },
        "required_persona_kinds": {
          "items": {
            "$ref": "#/$defs/PersonaKind"
          },
          "title": "Required Persona Kinds",
          "type": "array"
        },
        "safety_pass_rate": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Safety Pass Rate",
          "type": "number"
        }
      },
      "title": "ActivationThresholds",
      "type": "object"
    },
    "GraderId": {
      "description": "Deterministic graders (QV-SIM-004). `safety` graders must be 100 %; `completion` graders ≥ threshold.",
      "enum": [
        "no_invented_claims",
        "confirmation_before_writes",
        "unknown_question_policy_applied",
        "opt_out_respected",
        "handoff_correct",
        "required_fields_with_provenance",
        "outcome_produced",
        "expected_outcome_matched",
        "repetition_below_threshold",
        "budget_respected"
      ],
      "title": "GraderId",
      "type": "string"
    },
    "GraderResult": {
      "additionalProperties": false,
      "properties": {
        "blueprint_paths": {
          "description": "where a fix would land (QV-SIM-004)",
          "items": {
            "type": "string"
          },
          "title": "Blueprint Paths",
          "type": "array"
        },
        "category": {
          "enum": [
            "safety",
            "completion"
          ],
          "title": "Category",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "grader": {
          "$ref": "#/$defs/GraderId"
        },
        "model_graded": {
          "default": false,
          "title": "Model Graded",
          "type": "boolean"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "grader",
        "passed",
        "category"
      ],
      "title": "GraderResult",
      "type": "object"
    },
    "Injection": {
      "description": "Injected conditions (QV-SIM-002/003) applied on top of a persona.",
      "enum": [
        "none",
        "tool_failure",
        "missing_knowledge",
        "human_request",
        "objection_sequence",
        "opt_out",
        "provider_interruption",
        "unsupported_claim_request",
        "incomplete_customer_info"
      ],
      "title": "Injection",
      "type": "string"
    },
    "PersonaKind": {
      "description": "Required persona set (QV-SIM-002). Activities may add their own strings via `persona_id`.",
      "enum": [
        "normal",
        "confused",
        "skeptical",
        "demanding",
        "follow_up_asker",
        "comparison_asker",
        "corrector",
        "topic_switcher",
        "interrupter",
        "unsupported_question_asker"
      ],
      "title": "PersonaKind",
      "type": "string"
    },
    "ScenarioResult": {
      "additionalProperties": false,
      "properties": {
        "activity_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity State"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "dialog_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialog State"
        },
        "duration_ms": {
          "default": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "event_count": {
          "default": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "graders": {
          "items": {
            "$ref": "#/$defs/GraderResult"
          },
          "title": "Graders",
          "type": "array"
        },
        "injection": {
          "$ref": "#/$defs/Injection"
        },
        "interruption_count": {
          "default": 0,
          "title": "Interruption Count",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "persona_id": {
          "title": "Persona Id",
          "type": "string"
        },
        "persona_kind": {
          "$ref": "#/$defs/PersonaKind"
        },
        "primary_outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Outcome"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "tool_call_count": {
          "default": 0,
          "title": "Tool Call Count",
          "type": "integer"
        },
        "turn_count": {
          "default": 0,
          "title": "Turn Count",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "persona_id",
        "persona_kind",
        "injection",
        "passed",
        "session_id",
        "graders"
      ],
      "title": "ScenarioResult",
      "type": "object"
    },
    "SimulationFinding": {
      "additionalProperties": false,
      "description": "Aggregated failure → Blueprint path (feeds SIMULATION_FAILED or a quality gap).",
      "properties": {
        "blueprint_paths": {
          "items": {
            "type": "string"
          },
          "title": "Blueprint Paths",
          "type": "array"
        },
        "category": {
          "enum": [
            "safety",
            "completion"
          ],
          "title": "Category",
          "type": "string"
        },
        "failed_cases": {
          "items": {
            "type": "string"
          },
          "title": "Failed Cases",
          "type": "array"
        },
        "grader": {
          "$ref": "#/$defs/GraderId"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "BLOCK",
            "WARN"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "grader",
        "category",
        "failed_cases",
        "severity",
        "message"
      ],
      "title": "SimulationFinding",
      "type": "object"
    }
  },
  "$id": "https://qevion.dev/schemas/simulation_report_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "title": "Activity Id",
      "type": "string"
    },
    "activity_version": {
      "title": "Activity Version",
      "type": "string"
    },
    "adversarial_cases": {
      "default": 0,
      "title": "Adversarial Cases",
      "type": "integer"
    },
    "blueprint_fingerprint": {
      "description": "sha256 of the canonical Blueprint JSON the run used",
      "title": "Blueprint Fingerprint",
      "type": "string"
    },
    "completion_pass_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Completion Pass Rate",
      "type": "number"
    },
    "composition_id": {
      "title": "Composition Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/SimulationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "missing_persona_kinds": {
      "items": {
        "$ref": "#/$defs/PersonaKind"
      },
      "title": "Missing Persona Kinds",
      "type": "array"
    },
    "passed": {
      "description": "thresholds met AND required persona coverage AND adversarial present",
      "title": "Passed",
      "type": "boolean"
    },
    "persona_kinds_covered": {
      "items": {
        "$ref": "#/$defs/PersonaKind"
      },
      "title": "Persona Kinds Covered",
      "type": "array"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ScenarioResult"
      },
      "title": "Results",
      "type": "array"
    },
    "safety_pass_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Safety Pass Rate",
      "type": "number"
    },
    "schema": {
      "const": "qevion.simulation_report.v1",
      "default": "qevion.simulation_report.v1",
      "title": "Schema",
      "type": "string"
    },
    "session_kind": {
      "const": "simulation",
      "default": "simulation",
      "title": "Session Kind",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/ActivationThresholds"
    }
  },
  "required": [
    "report_id",
    "tenant_id",
    "activity_id",
    "activity_version",
    "blueprint_fingerprint",
    "composition_id",
    "thresholds",
    "results",
    "safety_pass_rate",
    "completion_pass_rate",
    "persona_kinds_covered",
    "passed"
  ],
  "title": "SimulationReport",
  "type": "object",
  "x-qevion-schema-id": "qevion.simulation_report.v1"
}
