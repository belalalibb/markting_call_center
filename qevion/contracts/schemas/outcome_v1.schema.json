{
  "$defs": {
    "Channel": {
      "enum": [
        "browser_voice",
        "text",
        "telephony"
      ],
      "title": "Channel",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "inbound",
        "outbound",
        "bidirectional"
      ],
      "title": "Direction",
      "type": "string"
    },
    "FieldValue": {
      "additionalProperties": false,
      "description": "A collected datum with provenance (§20 QV-FLD).",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "corrected_from": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected From"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "recorded_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At Ms"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "provenance"
      ],
      "title": "FieldValue",
      "type": "object"
    },
    "OutcomeTimestamps": {
      "additionalProperties": false,
      "properties": {
        "first_user_turn": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First User Turn"
        },
        "last_user_turn": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last User Turn"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "session_ended": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Ended"
        },
        "session_started": {
          "format": "date-time",
          "title": "Session Started",
          "type": "string"
        }
      },
      "required": [
        "session_started"
      ],
      "title": "OutcomeTimestamps",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a fact/field value came from (QV-FLD, §20).",
      "enum": [
        "USER_STATED",
        "TOOL_VERIFIED",
        "SYSTEM_DERIVED",
        "KNOWLEDGE_APPROVED",
        "UNVERIFIED",
        "UNKNOWN"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "ToolProvenanceEntry": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "fields_affected": {
          "items": {
            "type": "string"
          },
          "title": "Fields Affected",
          "type": "array"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool_id",
        "status"
      ],
      "title": "ToolProvenanceEntry",
      "type": "object"
    }
  },
  "$id": "https://qevion.dev/schemas/outcome_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministically generated by Core from events + FieldStore + completion rules (QV-OUT-001).",
  "properties": {
    "activity_id": {
      "title": "Activity Id",
      "type": "string"
    },
    "activity_version": {
      "title": "Activity Version",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "collected_fields": {
      "items": {
        "$ref": "#/$defs/FieldValue"
      },
      "title": "Collected Fields",
      "type": "array"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "handoff_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Handoff Ref"
    },
    "inferred_fields": {
      "items": {
        "type": "string"
      },
      "title": "Inferred Fields",
      "type": "array"
    },
    "knowledge_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Knowledge Versions",
      "type": "object"
    },
    "line_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line Id"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "observations": {
      "items": {
        "type": "string"
      },
      "title": "Observations",
      "type": "array"
    },
    "outcome_id": {
      "title": "Outcome Id",
      "type": "string"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "primary": {
      "description": "BaseOutcome value or Activity-defined string",
      "title": "Primary",
      "type": "string"
    },
    "rejected_fields": {
      "items": {
        "type": "string"
      },
      "title": "Rejected Fields",
      "type": "array"
    },
    "schema": {
      "const": "qevion.outcome.v1",
      "default": "qevion.outcome.v1",
      "title": "Schema",
      "type": "string"
    },
    "secondary": {
      "items": {
        "type": "string"
      },
      "title": "Secondary",
      "type": "array"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "summary_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "model-generated; NOT business truth (QV-OUT-002)",
      "title": "Summary Text"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "timestamps": {
      "$ref": "#/$defs/OutcomeTimestamps"
    },
    "tool_provenance": {
      "items": {
        "$ref": "#/$defs/ToolProvenanceEntry"
      },
      "title": "Tool Provenance",
      "type": "array"
    },
    "verified_fields": {
      "items": {
        "type": "string"
      },
      "title": "Verified Fields",
      "type": "array"
    }
  },
  "required": [
    "outcome_id",
    "session_id",
    "tenant_id",
    "activity_id",
    "activity_version",
    "direction",
    "channel",
    "primary",
    "timestamps"
  ],
  "title": "Outcome",
  "type": "object",
  "x-qevion-schema-id": "qevion.outcome.v1"
}
