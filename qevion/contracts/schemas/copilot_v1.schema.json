{
  "$defs": {
    "ActivityBlueprint": {
      "additionalProperties": false,
      "description": "Top-level `qevion.activity.v1` (§9.1).",
      "properties": {
        "activity_machine": {
          "$ref": "#/$defs/ActivityMachineRef"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/Channel"
          },
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "completion": {
          "$ref": "#/$defs/Completion"
        },
        "constrained_flow": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConstrainedFlow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coverage": {
          "$ref": "#/$defs/CoverageBlock"
        },
        "data": {
          "$ref": "#/$defs/DataBlock"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "evaluation": {
          "$ref": "#/$defs/Evaluation"
        },
        "handoff_rules": {
          "items": {
            "$ref": "#/$defs/HandoffRule"
          },
          "title": "Handoff Rules",
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "knowledge": {
          "$ref": "#/$defs/KnowledgeBlock"
        },
        "locale": {
          "$ref": "#/$defs/Locale"
        },
        "objective": {
          "$ref": "#/$defs/Objective"
        },
        "outcome_schema": {
          "$ref": "#/$defs/OutcomeSchema"
        },
        "policies": {
          "$ref": "#/$defs/PolicyBlock"
        },
        "schema": {
          "const": "qevion.activity.v1",
          "default": "qevion.activity.v1",
          "title": "Schema",
          "type": "string"
        },
        "tools": {
          "$ref": "#/$defs/ToolsBlock"
        },
        "version_metadata": {
          "$ref": "#/$defs/VersionMetadata"
        }
      },
      "required": [
        "identity",
        "direction",
        "channels",
        "locale",
        "objective",
        "policies",
        "outcome_schema"
      ],
      "title": "ActivityBlueprint",
      "type": "object"
    },
    "ActivityMachineRef": {
      "additionalProperties": false,
      "properties": {
        "inline": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inline"
        },
        "table_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "generic_default_v1",
          "title": "Table Ref"
        }
      },
      "title": "ActivityMachineRef",
      "type": "object"
    },
    "AnswerType": {
      "enum": [
        "free_text",
        "choice",
        "yes_no",
        "number",
        "upload",
        "confirm_proposal"
      ],
      "title": "AnswerType",
      "type": "string"
    },
    "Behavior": {
      "description": "QV-POL-004 unknown-question / uncertainty behaviors. 'The model decides' is NOT a value.",
      "enum": [
        "ANSWER_FROM_APPROVED_KNOWLEDGE",
        "ASK_CLARIFYING_QUESTION",
        "STATE_LIMITATION",
        "USE_AUTHORIZED_TOOL",
        "ASK_OPERATOR_SOURCE",
        "OFFER_HUMAN_HANDOFF",
        "COLLECT_QUESTION",
        "REQUEST_ADDITIONAL_INFORMATION",
        "CLOSE_GRACEFULLY",
        "DECLINE_UNSUPPORTED_REQUEST"
      ],
      "title": "Behavior",
      "type": "string"
    },
    "BehaviorOverride": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "$ref": "#/$defs/Behavior"
        },
        "topic_pattern": {
          "title": "Topic Pattern",
          "type": "string"
        }
      },
      "required": [
        "topic_pattern",
        "behavior"
      ],
      "title": "BehaviorOverride",
      "type": "object"
    },
    "CapabilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/MappingResult"
        },
        "current_state": {
          "title": "Current State",
          "type": "string"
        },
        "integration": {
          "$ref": "#/$defs/IntegrationClass"
        },
        "required_capability": {
          "title": "Required Capability",
          "type": "string"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "requirement",
        "required_capability",
        "current_state",
        "action",
        "integration"
      ],
      "title": "CapabilityRequirement",
      "type": "object"
    },
    "Channel": {
      "enum": [
        "browser_voice",
        "text",
        "telephony"
      ],
      "title": "Channel",
      "type": "string"
    },
    "ClaimRule": {
      "additionalProperties": false,
      "properties": {
        "claim_type": {
          "title": "Claim Type",
          "type": "string"
        },
        "scope": {
          "default": "activity",
          "title": "Scope",
          "type": "string"
        },
        "source_requirement": {
          "anyOf": [
            {
              "enum": [
                "KNOWLEDGE_APPROVED",
                "TOOL_VERIFIED",
                "ANY_APPROVED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Requirement"
        }
      },
      "required": [
        "claim_type"
      ],
      "title": "ClaimRule",
      "type": "object"
    },
    "Completion": {
      "additionalProperties": false,
      "properties": {
        "exit_rules": {
          "items": {
            "type": "string"
          },
          "title": "Exit Rules",
          "type": "array"
        },
        "failure_rules": {
          "items": {
            "type": "string"
          },
          "title": "Failure Rules",
          "type": "array"
        },
        "success_rules": {
          "items": {
            "type": "string"
          },
          "title": "Success Rules",
          "type": "array"
        }
      },
      "title": "Completion",
      "type": "object"
    },
    "ConstrainedFlow": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "title": "ConstrainedFlow",
      "type": "object"
    },
    "ContactPolicyHooks": {
      "additionalProperties": false,
      "description": "Outbound-only hooks (ADR-0003).",
      "properties": {
        "attempt_limit": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Attempt Limit",
          "type": "integer"
        },
        "consent_required": {
          "default": true,
          "title": "Consent Required",
          "type": "boolean"
        },
        "contact_window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. \"10:00-20:00 Africa/Cairo\"",
          "title": "Contact Window"
        },
        "suppression_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppression Ref"
        }
      },
      "title": "ContactPolicyHooks",
      "type": "object"
    },
    "Contradiction": {
      "additionalProperties": false,
      "properties": {
        "contradiction_id": {
          "title": "Contradiction Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Fact Ids",
          "type": "array"
        },
        "resolution": {
          "default": "pending",
          "enum": [
            "pending",
            "prefer_higher_priority",
            "operator_decided",
            "both_rejected"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "winning_fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winning Fact Id"
        }
      },
      "required": [
        "contradiction_id",
        "tenant_id",
        "fact_ids",
        "description"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "CopilotQuestion": {
      "additionalProperties": false,
      "description": "One prioritized question. `target_path` says which Blueprint element the answer will fill.",
      "properties": {
        "answer_type": {
          "$ref": "#/$defs/AnswerType",
          "default": "free_text"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/QuestionKind"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "priority": {
          "description": "lower = ask sooner; computed deterministically",
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "proposed_default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a suggestion the operator may accept; never auto-applied for business decisions",
          "title": "Proposed Default"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "source_refs": {
          "description": "gap ids / finding paths / mapping capabilities that produced this question",
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "target_path": {
          "description": "Blueprint JSON path the answer resolves, e.g. policies.opt_out",
          "title": "Target Path",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "why_it_matters": {
          "title": "Why It Matters",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "kind",
        "priority",
        "text",
        "why_it_matters",
        "target_path"
      ],
      "title": "CopilotQuestion",
      "type": "object"
    },
    "CoverageBlock": {
      "additionalProperties": false,
      "properties": {
        "exceptions": {
          "items": {
            "$ref": "#/$defs/CoverageException"
          },
          "title": "Exceptions",
          "type": "array"
        },
        "objections": {
          "items": {
            "$ref": "#/$defs/CoverageObjection"
          },
          "title": "Objections",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/CoverageQuestion"
          },
          "title": "Questions",
          "type": "array"
        }
      },
      "title": "CoverageBlock",
      "type": "object"
    },
    "CoverageException": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "title": "Behavior",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "situation": {
          "title": "Situation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "situation",
        "behavior"
      ],
      "title": "CoverageException",
      "type": "object"
    },
    "CoverageObjection": {
      "additionalProperties": false,
      "properties": {
        "allowed_alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Alternatives",
          "type": "array"
        },
        "approved_response_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Response Ref"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "status": {
          "default": "ASK_OWNER",
          "enum": [
            "COVERED",
            "ASK_OWNER",
            "DECLINED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "pattern"
      ],
      "title": "CoverageObjection",
      "type": "object"
    },
    "CoverageQuestion": {
      "additionalProperties": false,
      "properties": {
        "answer_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Ref"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "entity_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Ref"
        },
        "handling": {
          "enum": [
            "KNOWLEDGE",
            "TOOL",
            "CLARIFY",
            "LIMITATION",
            "HANDOFF"
          ],
          "title": "Handling",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "status": {
          "default": "ASK_OWNER",
          "enum": [
            "COVERED",
            "ASK_OWNER",
            "DECLINED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "pattern",
        "handling"
      ],
      "title": "CoverageQuestion",
      "type": "object"
    },
    "DataBlock": {
      "additionalProperties": false,
      "properties": {
        "optional": {
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Optional",
          "type": "array"
        },
        "required": {
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Required",
          "type": "array"
        }
      },
      "title": "DataBlock",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "QV-ACT-002: every business-decision element carries who proposed and who approved it.",
      "properties": {
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "operator id; None = unapproved → blocks activation",
          "title": "Approved By"
        },
        "item_path": {
          "title": "Item Path",
          "type": "string"
        },
        "proposed_by": {
          "$ref": "#/$defs/ProposedBy"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "item_path",
        "proposed_by"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "inbound",
        "outbound",
        "bidirectional"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Disclosure": {
      "additionalProperties": false,
      "properties": {
        "text_ref": {
          "title": "Text Ref",
          "type": "string"
        },
        "when": {
          "description": "dialog/activity state name or trigger, e.g. OPENING",
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "when",
        "text_ref"
      ],
      "title": "Disclosure",
      "type": "object"
    },
    "DiscoveryStatus": {
      "enum": [
        "asking",
        "review",
        "blocked"
      ],
      "title": "DiscoveryStatus",
      "type": "string"
    },
    "EscalationRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "title": "Priority",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "action"
      ],
      "title": "EscalationRule",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "adversarial_cases": {
          "items": {
            "type": "string"
          },
          "title": "Adversarial Cases",
          "type": "array"
        },
        "cases": {
          "items": {
            "type": "string"
          },
          "title": "Cases",
          "type": "array"
        },
        "simulation_personas": {
          "items": {
            "type": "string"
          },
          "title": "Simulation Personas",
          "type": "array"
        }
      },
      "title": "Evaluation",
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "description": "A datum the Activity needs. Names are Activity data; Core never knows them (QV-ACT-004).",
      "properties": {
        "clarification_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Hint"
        },
        "enum_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum Values"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "provenance_required": {
          "$ref": "#/$defs/Provenance",
          "default": "USER_STATED"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "low"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "enum",
            "entity_ref",
            "list"
          ],
          "title": "Type",
          "type": "string"
        },
        "validation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "expression or rule ref evaluated by decision port",
          "title": "Validation"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "max_age_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Age Days"
        },
        "stale_behavior": {
          "default": "STATE_LIMITATION",
          "title": "Stale Behavior",
          "type": "string"
        }
      },
      "title": "Freshness",
      "type": "object"
    },
    "GapClass": {
      "enum": [
        "REQUIRED_FOR_EXECUTION",
        "IMPORTANT_FOR_QUALITY",
        "OPTIONAL_IMPROVEMENT",
        "POLICY_RISK",
        "DATA_CONFLICT",
        "UNKNOWN"
      ],
      "title": "GapClass",
      "type": "string"
    },
    "HandoffRule": {
      "additionalProperties": false,
      "properties": {
        "context_projection": {
          "items": {
            "type": "string"
          },
          "title": "Context Projection",
          "type": "array"
        },
        "destination_ref": {
          "title": "Destination Ref",
          "type": "string"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "title": "Priority",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "destination_ref"
      ],
      "title": "HandoffRule",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "title": "Activity Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReadinessState",
          "default": "DRAFT"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "activity_id",
        "name",
        "version"
      ],
      "title": "Identity",
      "type": "object"
    },
    "IntegrationClass": {
      "description": "QV-COP-009.",
      "enum": [
        "no_integration_needed",
        "configuration_only",
        "existing_integration_available",
        "new_integration_required",
        "new_core_capability_required"
      ],
      "title": "IntegrationClass",
      "type": "string"
    },
    "KnowledgeBlock": {
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/KnowledgeRequirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "source_priority": {
          "items": {
            "type": "string"
          },
          "title": "Source Priority",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeSourceRef"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "KnowledgeBlock",
      "type": "object"
    },
    "KnowledgeGap": {
      "additionalProperties": false,
      "properties": {
