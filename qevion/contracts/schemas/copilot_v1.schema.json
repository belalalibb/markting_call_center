  "$id": "https://qevion.dev/schemas/copilot_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "QV-COP-015 (B). Every business-decision element in `draft` carries a Decision in `decisions`.",
  "properties": {
    "capability_requirements": {
      "items": {
        "$ref": "#/$defs/CapabilityRequirement"
      },
      "title": "Capability Requirements",
      "type": "array"
    },
    "config_session_id": {
      "title": "Config Session Id",
      "type": "string"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivityBlueprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "draft_valid": {
      "default": false,
      "title": "Draft Valid",
      "type": "boolean"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/KnowledgeGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "preflight_findings": {
      "items": {
        "$ref": "#/$defs/PreflightFinding"
      },
      "title": "Preflight Findings",
      "type": "array"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "questions": {
      "description": "prioritized; empty when status=review",
      "items": {
        "$ref": "#/$defs/CopilotQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "readiness_findings": {
      "items": {
        "$ref": "#/$defs/ReadinessFinding"
      },
      "title": "Readiness Findings",
      "type": "array"
    },
    "readiness_state": {
      "$ref": "#/$defs/ReadinessState",
      "default": "DRAFT"
    },
    "schema": {
      "const": "qevion.copilot.v1",
      "default": "qevion.copilot.v1",
      "title": "Schema",
      "type": "string"
    },
    "simulation_cases": {
      "items": {
        "type": "string"
      },
      "title": "Simulation Cases",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/DiscoveryStatus",
      "default": "asking"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "validation_errors": {
      "items": {
        "type": "string"
      },
      "title": "Validation Errors",
      "type": "array"
    }
  },
  "required": [
    "proposal_id",
    "config_session_id",
