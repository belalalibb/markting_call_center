{
  "$id": "https://qevion.dev/schemas/knowledge_contradiction_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contradiction_id": {
      "title": "Contradiction Id",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "fact_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Fact Ids",
      "type": "array"
    },
    "resolution": {
      "default": "pending",
      "enum": [
        "pending",
        "prefer_higher_priority",
        "operator_decided",
        "both_rejected"
      ],
      "title": "Resolution",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "winning_fact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Winning Fact Id"
    }
  },
  "required": [
    "contradiction_id",
    "tenant_id",
    "fact_ids",
    "description"
  ],
  "title": "Contradiction",
  "type": "object",
  "x-qevion-schema-id": "qevion.knowledge_contradiction.v1"
}
