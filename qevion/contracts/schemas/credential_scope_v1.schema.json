{
  "$defs": {
    "CredentialSource": {
      "enum": [
        "env",
        "admin_store",
        "ephemeral_ui",
        "none"
      ],
      "title": "CredentialSource",
      "type": "string"
    }
  },
  "$id": "https://qevion.dev/schemas/credential_scope_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What is logged/evented about a credential: NEVER the value (QV-CRED).",
  "properties": {
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "last-4 or hash prefix for support; never the key",
      "title": "Fingerprint"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CredentialSource"
    },
    "tenant_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Id"
    }
  },
  "required": [
    "provider",
    "source"
  ],
  "title": "CredentialScope",
  "type": "object",
  "x-qevion-schema-id": "qevion.credential_scope.v1"
}
