{
  "$defs": {
    "AudioFormat": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "const": 1,
          "default": 1,
          "title": "Channels",
          "type": "integer"
        },
        "encoding": {
          "const": "pcm16",
          "default": "pcm16",
          "title": "Encoding",
          "type": "string"
        },
        "sample_rate_hz": {
          "default": 24000,
          "enum": [
            8000,
            16000,
            24000,
            48000
          ],
          "title": "Sample Rate Hz",
          "type": "integer"
        }
      },
      "title": "AudioFormat",
      "type": "object"
    }
  },
  "$id": "https://qevion.dev/schemas/transport_hello_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "title": "Activity Id",
      "type": "string"
    },
    "activity_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activity Version"
    },
    "channel": {
      "default": "browser_voice",
      "enum": [
        "browser_voice",
        "text"
      ],
      "title": "Channel",
      "type": "string"
    },
    "client_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Client Capabilities",
      "type": "array"
    },
    "direction": {
      "default": "inbound",
